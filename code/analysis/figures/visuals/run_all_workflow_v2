digraph RunAllWorkflow {
    rankdir=TB
    size="8,11"
    bgcolor="#ffffff"
    node [shape=box, style="filled,rounded", fontname="Helvetica", color=black, fontsize=10]
    edge [color=gray50, arrowsize=0.7]

    // Title
    labelloc="t"
    label="ML Analysis Pipeline"
    fontsize=14
    fontname="Helvetica-Bold"

    // TIER 1 - darkest green
    T1 [label="TIER 1\nIndependent Analyses", fillcolor="#2e7d32"]

    // TIER 2
    T2 [label="TIER 2\nData Setup", fillcolor="#388e3c"]

    // Data split
    subgraph cluster_split {
        label=""
        style="invis"
        rank=same

        Train [label="Train (80%)", shape=folder, fillcolor="#a5d6a7", style="filled", fontsize=9]
        Test [label="Test (20%)", shape=folder, fillcolor="#e8f5e9", style="filled", fontsize=9]
    }

    // TIER 3
    T3 [label="TIER 3\nHyperparameter\nOptimization", fillcolor="#43a047"]

    // TIER 4
    T4 [label="TIER 4\nFeature Comparison", fillcolor="#4caf50"]

    // TIER 5 - highlighted
    T5 [label="TIER 5\nFinal Model Training\n& Test Evaluation", fillcolor="#66bb6a", style="filled,rounded,bold"]

    // TIER 6
    T6 [label="TIER 6\nSHAP Analysis", fillcolor="#81c784"]

    // TIER 7 - lightest green
    T7 [label="TIER 7\nPost-Hoc Statistics", fillcolor="#a5d6a7"]

    // Edges
    T1 -> T2
    T2 -> Train
    T2 -> Test

    Train -> T3
    T3 -> T4
    T4 -> T5

    Test -> T5 [style=dashed, color="#d32f2f", penwidth=1.5]

    T5 -> T6
    T6 -> T7
}
